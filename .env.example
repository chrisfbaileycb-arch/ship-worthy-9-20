# There is no model key here on purpose. Model-backed analyses run on each visitor's own Gemini key,
# which they enter in the app and which is sent per request. The server reads none from its
# environment, so setting one has no effect and there is no operator key to spend.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# FIREBASE CONFIGURATION (Optional - durable local storage fallback used if omitted)
# Set these to enable server-side Firebase Firestore, Auth, and App Check
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY=
FIRESTORE_EMULATOR_HOST=

# OPERATOR SECURITY & SESSION SECRETS
SESSION_SECRET=
INTERNAL_AUTH_USER=
INTERNAL_AUTH_PASS_HASH=
DEFENSE_OF_BREAK_PASSCODES=
